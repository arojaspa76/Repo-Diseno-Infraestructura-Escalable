# Copie a .env y ajuste. NUNCA suba .env a Git.

# --- Gateway (backend/) ---
ENVIRONMENT=dev                       # dev | staging | prod (fuera de dev, GATEWAY_API_KEYS es obligatorio)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
GATEWAY_API_KEYS=                     # vacío = sin autenticación (solo dev). Ej.: clave1,clave2
MAX_INPUT_CHARS=4000
MAX_OUTPUT_TOKENS=512
RATE_LIMIT_PER_MINUTE=30
REDACT_PII=true
LOG_PROMPTS=false                     # false = nunca registrar contenido de conversaciones

# --- FinOps (PRECIOS ILUSTRATIVOS: reemplácelos por los de su proveedor) ---
REF_PRICE_INPUT_PER_MTOK_USD=1.00
REF_PRICE_OUTPUT_PER_MTOK_USD=4.00
INFRA_COST_PER_HOUR_USD=0             # costo/hora de su VM o GPU; 0 en su portátil
DAILY_BUDGET_USD_PER_CLIENT=0.50
BUDGET_ALERT_LEVELS=50,80,100
