# Copie a .env (NO lo suba a Git)
# Portal Foundry -> su proyecto -> Overview -> "Project endpoint"
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# Nombre del DEPLOYMENT del modelo (no el nombre del modelo base), p. ej. el que creó en el portal
FOUNDRY_MODEL_DEPLOYMENT=<nombre-del-deployment>
