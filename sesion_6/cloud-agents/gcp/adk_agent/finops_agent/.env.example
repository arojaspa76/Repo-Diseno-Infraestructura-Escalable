# Copie a .env (NO lo suba a Git). ADK carga este archivo desde la carpeta del agente.
# Usar Vertex AI / Agent Platform con IAM en ADK 2.x (en versiones anteriores: GOOGLE_GENAI_USE_VERTEXAI=TRUE)
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=su-proyecto-id
# us-central1 o "global" según disponibilidad del modelo elegido
GOOGLE_CLOUD_LOCATION=us-central1
# Verifique el ID vigente en Model Garden
GEMINI_MODEL=gemini-flash-latest
