# Copie este archivo a .env y ajuste. NUNCA suba .env a Git.
S07_OLLAMA_BASE_URL=http://localhost:11434
S07_DEFAULT_MODEL=llama3.2:1b
S07_EMBED_MODEL=nomic-embed-text

# Si se define, el backend exige el encabezado X-API-Key. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
S07_API_KEY=

S07_RATE_LIMIT_PER_MINUTE=60
S07_MAX_INPUT_CHARS=8000
S07_MAX_OUTPUT_TOKENS=512
# block = rechaza | flag = solo marca | off = desactiva guardrails
S07_GUARD_MODE=block
S07_CORS_ORIGINS=http://localhost:5173
S07_LOG_LEVEL=INFO
S07_CACHE_DB_PATH=./data/embedding_cache.sqlite3
S07_OTEL_ENABLED=false
