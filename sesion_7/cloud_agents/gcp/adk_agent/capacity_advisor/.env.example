# Opción A — Gemini API (rápido para clase; clave de Google AI Studio)
GOOGLE_API_KEY=pegue_su_clave_aqui

# Opción B — Vertex AI (enterprise; autenticación con credenciales de Google Cloud, SIN claves en archivos)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=su-proyecto
# GOOGLE_CLOUD_LOCATION=us-central1
# (autentíquese con:  gcloud auth application-default login)

# Modelo (opcional)
# ADK_MODEL=gemini-flash-latest
